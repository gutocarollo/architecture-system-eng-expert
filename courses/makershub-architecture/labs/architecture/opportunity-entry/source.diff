+            "action=super_r1_pool_active_check_failed_open | candidates=%s | error=%s",
+            candidates, exc,
+        )
+        return candidates
+
+    schedulable = [
+        i for i in candidates if described.get(sf_ids[i], {}).get("isActive")
+    ]
+    inactive = sorted(set(candidates) - set(schedulable))
+    if inactive:
